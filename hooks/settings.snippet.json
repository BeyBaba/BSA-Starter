{
  "_comment": "v3.2: `bash hooks/install.sh` bu girdileri ~/.claude/settings.json'daki hooks nesnesine IDEMPOTENT ekler. __BASH__ kurulumda git-bash TAM yoluyla (WSL bash'ine dusmesin), __HOOKS_DIR__ gercek CLAUDE_HOME/hooks yoluyla degistirilir; sabit kullanici yolu yok. Mevcut ciplak 'bash ...' girdileri tam yola tasinir. Elle yapistirmak gerekmez.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"__BASH__\" \"__HOOKS_DIR__/pre-bash-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"__BASH__\" \"__HOOKS_DIR__/pre-write-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BASH__\" \"__HOOKS_DIR__/global-session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BASH__\" \"__HOOKS_DIR__/global-session-end.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__BASH__\" \"__HOOKS_DIR__/pre-compact.sh\""
          }
        ]
      }
    ]
  }
}
