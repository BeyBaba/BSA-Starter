# Bash hook/kurulum betikleri ve kural dosyalari her platformda LF (CRLF gelirse rules.txt TOOL sutunu "ANY"+CR olur, guard fail-open; inbox dersi 2026-09-22)
.gitattributes text eol=lf
*.sh text eol=lf
*.cmd text eol=lf
hooks/** text eol=lf
skills/** text eol=lf
agents/** text eol=lf
.github/** text eol=lf
bsa-starter/.github/** text eol=lf
*.yml text eol=lf
# bootstrap .bat dosyasi cmd.exe icin CRLF olmali (LF ile goto/label ve parantez bloklari bozulabilir)
bootstrap/*.bat text eol=crlf
